// ============================================
// GESCOLA - Schema Prisma
// Fase 1: Módulo de Vendas
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USUÁRIOS
// ============================================

enum UserRole {
  ADMIN
  CAPTACAO
  VENDAS
  RECEPCAO
}

enum UserStatus {
  ATIVO
  INATIVO
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          UserRole
  status        UserStatus @default(ATIVO)
  phone         String?
  avatarUrl     String?

  // Conta protegida: não aparece na lista de usuários e não pode ser
  // desativada nem rebaixada de perfil — protege o acesso do dono do
  // sistema contra exclusões acidentais.
  protectedAccount Boolean @default(false)

  // --- Cadastro de colaboradores (tela pedida pela cliente, com os campos
  // do sistema antigo) ---
  code            String?    @unique   // Código do colaborador
  admissionDate   DateTime?             // Data de admissão
  cpf             String?
  rg              String?
  birthDate       DateTime?
  mobile          String?               // Celular
  jobTitle        String?               // Cargo
  addressStreet   String?
  addressNumber   String?
  addressDistrict String?               // Bairro
  addressCity     String?
  addressState    String?
  addressZip      String?
  notes           String?    @db.Text  // Observações
  showEnrollment  Boolean    @default(true) // Aparece para efetuar matrícula
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  // Relacionamentos
  createdCampaigns Campaign[]    @relation("CampaignCreator")
  createdLeads     Lead[]        @relation("LeadCreator")
  assignedLeads    Lead[]        @relation("LeadAssignedTo")
  interactions     Interaction[]
  followups        Followup[]
  messages         LeadMessage[]
  enrollmentsAudit EnrollmentAudit[]
  enrollmentsMade  Enrollment[]   @relation("EnrollmentCreator")
  classesTeaching  Class[]       @relation("ClassProfessor")
  goals            Goal[]
  sessions         Session[]
  accounts         Account[]

  @@map("users")
}

// Auth.js v5 — modelos necessários
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// METAS MENSAIS POR VENDEDOR
// ============================================

model Goal {
  id              String   @id @default(cuid())
  userId          String
  month           Int      // 1-12
  year            Int      // 4 dígitos
  metaMatricula   Int      @default(0)
  metaFaturamento Decimal  @db.Decimal(12, 2) @default(0)
  metaFollowup    Int      @default(0)  // acionamentos
  metaIndicacao   Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([month, year])
  @@map("goals")
}

// ============================================
// CURSOS & TURMAS
// ============================================

enum CourseStatus {
  ATIVO
  INATIVO
  EM_BREVE
}

model Course {
  id             String       @id @default(cuid())
  name           String
  description    String?      @db.Text
  workloadHours  Int
  price          Decimal      @db.Decimal(10, 2)
  syllabus       String?      @db.Text
  status         CourseStatus @default(ATIVO)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  classes         Class[]
  leads           Lead[]
  aiLeads         Lead[]         @relation("LeadAiCourse")
  enrollments     Enrollment[]
  paymentMethods  CoursePaymentMethod[]

  @@map("courses")
}

// ============================================
// FORMAS DE PAGAMENTO (cadastro + associação ao curso)
// ============================================

/// Cadastro de formas de pagamento. A cliente pediu para poder cadastrar
/// "mais formas de pagamento" — antes a lista era fixa no código.
/// As formas ativas alimentam o cadastro de curso e a matrícula.
model PaymentMethodType {
  id          String   @id @default(cuid())
  description String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_method_types")
}

model CoursePaymentMethod {
  id        String        @id @default(cuid())
  courseId  String
  method    String        @db.Text
  details   String?       // ex: "3x sem juros", "10% desconto à vista"
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, method])
  @@map("course_payment_methods")
}

/// Cadastro de situações de turma — a cliente pediu para poder "alterar ou
/// criar os status" da turma. As situações ativas alimentam o select do
/// cadastro de turma.
model ClassStatusType {
  id          String   @id @default(cuid())
  description String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("class_status_types")
}

model Class {
  id          String      @id @default(cuid())
  courseId    String
  name        String
  code        String?     // código curto (ex: SOL-2026-1)
  schedule    Json?       // {days: ['SEG','QUA'], time: '19h-22h'}
  startDate   DateTime
  endDate     DateTime?
  maxStudents Int         @default(30)
  professorId String?
  status      String      @default("ABERTA") @db.Text
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor      User?           @relation("ClassProfessor", fields: [professorId], references: [id])
  preEnrollments PreEnrollment[]
  students       ClassStudent[]
  enrollments    Enrollment[]

  @@index([courseId])
  @@index([professorId])
  @@index([status])
  @@map("classes")
}

// ============================================
// MATRÍCULAS NA TURMA (relação Class x Lead)
// ============================================

enum ClassStudentStatus {
  ATIVA
  TRANCADA
  CONCLUIDA
  CANCELADA
}

model ClassStudent {
  id         String             @id @default(cuid())
  classId    String
  leadId     String
  status     ClassStudentStatus @default(ATIVA)
  enrolledAt DateTime           @default(now())
  finishedAt DateTime?
  notes      String?            @db.Text

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([classId, leadId])
  @@index([classId])
  @@index([leadId])
  @@index([status])
  @@map("class_students")
}

// ============================================
// CAMPANHAS DE MARKETING
// ============================================

enum CampaignStatus {
  PLANEJADA
  ATIVA
  PAUSADA
  ENCERRADA
}

enum CampaignChannel {
  INSTAGRAM
  FACEBOOK
  GOOGLE_ADS
  WHATSAPP
  EMAIL
  INDICACAO
  OUTRO
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  channel     CampaignChannel
  startDate   DateTime
  endDate     DateTime?
  budget      Decimal?        @db.Decimal(10, 2)
  status      CampaignStatus  @default(PLANEJADA)
  description String?         @db.Text
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User   @relation("CampaignCreator", fields: [createdById], references: [id])
  leads     Lead[]

  @@map("campaigns")
}

// ============================================
// FORMAS DE CONHECIMENTO (FONTES)
// ============================================
// Cadastro oficial de "como o cliente conheceu a escola".
// Alimenta o select de Fonte do cadastro de lead e o painel de Captação
// (bloco FONTE / CONHECIMENTO). Tela pedida pela cliente: Descrição,
// "Não gerar comissão" e Situação (Ativo / Inativo).

model LeadSource {
  id           String   @id @default(cuid())
  description  String   @unique
  noCommission Boolean  @default(false) // "Não gerar comissão"
  active       Boolean  @default(true)  // Situação: Ativo / Inativo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads Lead[]

  @@map("lead_sources")
}

// ============================================
// LEADS (núcleo do funil)
// ============================================

enum LeadStatus {
  NOVO
  QUALIFICADO
  PROPOSTA_ENVIADA
  EM_NEGOCIACAO
  AGUARDANDO_ANALISE
  DEVOLVIDA_AJUSTE
  APROVADA
  PERDIDA
  // --- Sprint 11 — status expandidos do cliente (planilha SISTEMA WILLIAM.xlsx) ---
  QUARTO_CONTATO // 4º CTT
  BLOQUEIOU      // cliente bloqueou contato
  CONCORRENTE    // foi pra escola concorrente
  FIN_SEM_RENDA  // sem renda / sem condição financeira
  INATIVO        // lead frio, sem retorno
}

enum LeadPriority {
  ALTA
  MEDIA
  BAIXA
}

// ============================================
// status do cliente (classificação do vendedor)
// ============================================
// Campo SEPARADO do status de fluxo (LeadStatus). O vendedor classifica
// cada cliente com estes status; onde antes aparecia "DEVOLVIDA" na listagem,
// passa a aparecer o status do cliente que o vendedor preencheu.

enum SalesStatus {
  NEGOCIANDO
  MATRICULADO
  RETORNAR
  BLOQUEIOU
  FECHOU_CONCORRENTE
  FIN_SEM_RENDA
  CIDADE_110KM
  OUTRA_UNIDADE
  ADM_RESOLVER
  DUPLICADO
  OPORTUNIDADE_VENDAS
  VISITA
}

model Lead {
  id           String       @id @default(cuid())
  fullName     String
  email        String?
  phone        String
  phone2       String?       // 2º telefone de contato
  phone3       String?       // 3º telefone de contato
  cpf          String?
  source       String?       // como o cliente conheceu a escola ("fonte") — nome da Fonte
  sourceId     String?       // vínculo com o cadastro de Formas de Conhecimento
  status       LeadStatus   @default(NOVO)
  salesStatus  SalesStatus  @default(NEGOCIANDO) // classificação do vendedor
  priority     LeadPriority @default(MEDIA)
  courseId     String?
  campaignId   String?
  assignedToId String?
  createdById  String
  notes        String?      @db.Text
  lostReason   String?      @db.Text

  // ---- Captação via WhatsApp (Sprint 22) ----
  // "wa_id" do contato no WhatsApp (E.164 sem o +). Chave de identificação.
  whatsappId   String?
  // Análise automática da primeira mensagem (regras + IA).
  aiSummary    String?      @db.Text // resumo em 2-3 linhas para o time de vendas
  aiTags       String[]     @default([]) // tags detectadas (boleto, visita, presencial...)
  aiScore      Int?         // interesse estimado, 0-100
  aiIntent     String?      // intenção: duvida, matricula, pagamento, agendamento...
  aiStatus     SalesStatus? // "status do cliente" sugerido pela análise
  aiCourseId   String?      // curso sugerido pela análise (ainda não aplicado)
  aiModel      String?      // "llm" (análise por IA) ou "regras" (sem IA)
  aiRaw        String?      @db.Text // resposta bruta da IA (auditoria)
  aiAnalyzedAt DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  course       Course?         @relation(fields: [courseId], references: [id])
  campaign     Campaign?       @relation(fields: [campaignId], references: [id])
  assignedTo   User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User            @relation("LeadCreator", fields: [createdById], references: [id])
  aiCourse     Course?         @relation("LeadAiCourse", fields: [aiCourseId], references: [id])
  leadSource   LeadSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  interactions Interaction[]
  followups    Followup[]
  messages     LeadMessage[]
  preEnrollment PreEnrollment?
  enrollment   Enrollment?
  documents    Document[]
  audits       EnrollmentAudit[]
  classStudents ClassStudent[]
  whatsappInbounds WhatsappInbound[]

  @@index([status])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([whatsappId])
  @@map("leads")
}

// ============================================
// MENSAGENS DO LEAD (chat-log por lead)
// ============================================
// Armazena as mensagens trocadas com o lead (WhatsApp, ligação, e-mail,
// reunião presencial, etc.). Diferente de Interaction (log técnico) e
// Followup (registro operacional de contato proativo), LeadMessage é o
// CONTEÚDO da conversa, para que gerência possa auditar.

enum MessageChannel {
  WHATSAPP
  LIGACAO
  EMAIL
  REUNIAO
  PRESENCIAL
  OUTRO
}

enum MessageDirection {
  // Mensagem enviada pelo vendedor para o lead
  OUTBOUND
  // Mensagem recebida do lead
  INBOUND
  // Apenas anotação interna (não enviada nem recebida, mas relevante)
  INTERNAL
}

model LeadMessage {
  id        String           @id @default(cuid())
  leadId    String
  userId    String           // quem registrou (vendedor/admin)
  channel   MessageChannel
  direction MessageDirection
  content   String           @db.Text
  occurredAt DateTime        @default(now())
  createdAt DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId, occurredAt])
  @@index([userId])
  @@map("lead_messages")
}

// ============================================
// FOLLOW-UPS (registro estruturado de acionamentos)
// ============================================
// Diferente de Interaction (log genérico), Followup é um registro
// operacional de contato proativo com:
//  - type (canal)
//  - outcome (RESULTADO do contato)
//  - nextAction (próximo contato agendado)
// Permite métricas: "acionados por dia", "leads parados há X dias",
// "próximos contatos da semana".

enum FollowupType {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  OUTRO
}

enum FollowupOutcome {
  ATENDEU
  NAO_ATENDEU
  RECADO
  DESISTIU
  REAGENDOU
  SEM_RESPOSTA
}

model Followup {
  id            String          @id @default(cuid())
  leadId        String
  userId        String          // vendedor que registrou
  type          FollowupType
  outcome       FollowupOutcome
  salesStatus   SalesStatus?    // status que o vendedor colocou na venda
  notes         String?         @db.Text
  nextAction    DateTime?       // data agendada para próximo contato
  nextActionDone Boolean        @default(false)
  occurredAt    DateTime        @default(now())  // quando aconteceu o contato
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([occurredAt])
  @@index([nextAction])
  @@index([nextActionDone])
  @@map("followups")
}

// ============================================
// INTERAÇÕES (histórico de contato)
// ============================================

enum InteractionType {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  OUTRO
}

model Interaction {
  id          String          @id @default(cuid())
  leadId      String
  type        InteractionType
  description String          @db.Text
  occurredAt  DateTime        @default(now())
  createdById String
  createdAt   DateTime        @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([leadId])
  @@map("interactions")
}

// ============================================
// CAPTAÇÃO VIA WHATSAPP (Sprint 22)
// ============================================
// Cada mensagem recebida no WhatsApp da Captação vira um registro aqui.
// Serve para: deduplicar (a Meta reenvia a mesma mensagem), auditar o
// payload original e guardar a análise gerada antes de virar Lead.

enum WhatsappInboundStatus {
  // Mensagem gravada, aguardando análise
  RECEBIDA
  // Analisada (por IA ou por regras) e lead criado/atualizado
  ANALISADA
  // Mensagem sem utilidade (status de entrega, mídia sem texto, spam)
  IGNORADA
  // Falha no processamento (detalhada em "error")
  ERRO
}

model WhatsappInbound {
  id         String                @id @default(cuid())
  wamid      String                @unique // id da mensagem na Meta (chave de dedupe)
  waId       String                // contato em E.164 (5511987654321)
  phone      String                // telefone normalizado no formato do sistema
  pushname   String? // nome do perfil no WhatsApp
  type       String // text | image | audio | document | location...
  body       String                @db.Text // texto extraído da mensagem
  status     WhatsappInboundStatus @default(RECEBIDA)
  analysis   String?               @db.Text // JSON da análise (regras + IA)
  error      String?               @db.Text
  leadId     String?
  receivedAt DateTime              @default(now())
  createdAt  DateTime              @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([receivedAt])
  @@index([leadId])
  @@map("whatsapp_inbounds")
}

// ============================================
// PRÉ-MATRÍCULA
// ============================================

enum PreEnrollmentStatus {
  RASCUNHO
  AGUARDANDO_ANALISE
  DEVOLVIDA
  APROVADA
}

model PreEnrollment {
  id              String              @id @default(cuid())
  leadId          String              @unique
  classId         String?
  birthDate       DateTime?
  cpf             String?
  rg              String?
  addressStreet   String?
  addressNumber   String?
  addressComplement String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  guardianName    String?
  guardianCpf     String?
  guardianPhone   String?
  status          PreEnrollmentStatus @default(RASCUNHO)
  returnReason    String?             @db.Text
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lead  Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id])

  @@map("pre_enrollments")
}

// ============================================
// DOCUMENTOS
// ============================================

enum DocumentType {
  // --- Padrão definido pela cliente (checklist padrão do "Gerenciar Docs") ---
  RG
  CPF
  COMPRO_ENDERECO
  COMPRO_PAGAMENTO
  FOTO_ALUNO
  // --- Mantidos para compatibilidade com registros antigos ---
  COMPROVANTE_RESIDENCIA
  FOTO
  HISTORICO_ESCOLAR
  OUTRO
}

model Document {
  id         String       @id @default(cuid())
  leadId     String
  type       DocumentType
  fileName   String
  filePath   String       // caminho relativo ao STORAGE_PATH
  mimeType   String
  size       Int          // bytes
  version    Int          @default(1)
  uploadedById String
  uploadedAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@map("documents")
}

// ============================================
// MATRÍCULA (dados definitivos do aluno)
// ============================================
// Preenchidos pelo vendedor no botão "Realizar Matrícula".
// Ao salvar: cria o registro, marca o lead como MATRICULADO
// (status do cliente) e APROVADO (status de fluxo).

model Enrollment {
  id                String         @id @default(cuid())
  leadId            String         @unique
  courseId          String
  classId           String?
  fullName          String
  birthDate         DateTime?
  cpf               String?
  rg                String?
  phone             String
  phone2            String?
  email             String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressCity       String?
  addressState      String?
  addressZip        String?
  // Origem do aluno — usado no painel de Captação (blocos REDE SOCIAL e EMPRESAS)
  socialNetwork     String?
  company           String?
  paymentMethod     String?             @db.Text
  paymentDetails    String?        @db.Text
  installments      Int            @default(1)
  totalAmount       Decimal        @db.Decimal(10, 2)
  notes             String?        @db.Text
  enrolledById      String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id])
  class      Class? @relation(fields: [classId], references: [id])
  enrolledBy User  @relation("EnrollmentCreator", fields: [enrolledById], references: [id])

  @@map("enrollments")
}

// ============================================
// AUDITORIA
// ============================================

enum AuditAction {
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  PRE_ENROLLMENT_SUBMITTED
  PRE_ENROLLMENT_APPROVED
  PRE_ENROLLMENT_RETURNED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  DOCUMENT_UPLOADED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_STATUS_CHANGED
  // --- Sprint 20 — módulo de cadastro de alunos ---
  ENROLLMENT_CREATED
  ENROLLMENT_UPDATED
  ENROLLMENT_STATUS_CHANGED
}

model EnrollmentAudit {
  id         String      @id @default(cuid())
  leadId     String?
  action     AuditAction
  actorId    String
  details    String?     @db.Text
  targetType String?
  targetId   String?
  createdAt  DateTime    @default(now())

  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([leadId])
  @@index([actorId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("enrollment_audits")
}

// ============================================
// INTEGRAÇÕES
// ============================================
// Credenciais das integrações externas (Meta/WhatsApp, provedor de IA).
//
// O cliente configura isso pelo painel (Administração > Integrações) e o
// valor passa a valer na hora, sem novo deploy. Segredos (App Secret,
// token de acesso, chave da IA) são gravados CRIPTOGRAFADOS; o valor
// criptografado é derivado do AUTH_SECRET do servidor.

model IntegrationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("integration_settings")
}
