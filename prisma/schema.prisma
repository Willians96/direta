// ============================================
// GESCOLA - Schema Prisma
// Fase 1: Módulo de Vendas
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USUÁRIOS
// ============================================

enum UserRole {
  ADMIN
  CAPTACAO
  VENDAS
  RECEPCAO
}

enum UserStatus {
  ATIVO
  INATIVO
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          UserRole
  status        UserStatus @default(ATIVO)
  phone         String?
  avatarUrl     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  // Relacionamentos
  createdCampaigns Campaign[]    @relation("CampaignCreator")
  createdLeads     Lead[]        @relation("LeadCreator")
  assignedLeads    Lead[]        @relation("LeadAssignedTo")
  interactions     Interaction[]
  enrollmentsAudit EnrollmentAudit[]
  classesTeaching  Class[]       @relation("ClassProfessor")
  goals            Goal[]
  sessions         Session[]
  accounts         Account[]

  @@map("users")
}

// Auth.js v5 — modelos necessários
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// METAS MENSAIS POR VENDEDOR
// ============================================

model Goal {
  id              String   @id @default(cuid())
  userId          String
  month           Int      // 1-12
  year            Int      // 4 dígitos
  metaMatricula   Int      @default(0)
  metaFaturamento Decimal  @db.Decimal(12, 2) @default(0)
  metaFollowup    Int      @default(0)  // acionamentos
  metaIndicacao   Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([month, year])
  @@map("goals")
}

// ============================================
// CURSOS & TURMAS
// ============================================

enum CourseStatus {
  ATIVO
  INATIVO
  EM_BREVE
}

model Course {
  id             String       @id @default(cuid())
  name           String
  description    String?      @db.Text
  workloadHours  Int
  price          Decimal      @db.Decimal(10, 2)
  syllabus       String?      @db.Text
  status         CourseStatus @default(ATIVO)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  classes         Class[]
  leads           Lead[]
  paymentMethods  CoursePaymentMethod[]

  @@map("courses")
}

// ============================================
// FORMAS DE PAGAMENTO (associadas ao curso)
// ============================================

enum PaymentMethod {
  PIX
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  TRANSFERENCIA
  PARCELADO_PROPRIO
  OUTRO
}

model CoursePaymentMethod {
  id        String        @id @default(cuid())
  courseId  String
  method    PaymentMethod
  details   String?       // ex: "3x sem juros", "10% desconto à vista"
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, method])
  @@map("course_payment_methods")
}

enum ClassStatus {
  ABERTA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

model Class {
  id          String      @id @default(cuid())
  courseId    String
  name        String
  code        String?     // código curto (ex: SOL-2026-1)
  schedule    Json?       // {days: ['SEG','QUA'], time: '19h-22h'}
  startDate   DateTime
  endDate     DateTime?
  maxStudents Int         @default(30)
  professorId String?
  status      ClassStatus @default(ABERTA)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor      User?           @relation("ClassProfessor", fields: [professorId], references: [id])
  preEnrollments PreEnrollment[]
  students       ClassStudent[]

  @@index([courseId])
  @@index([professorId])
  @@index([status])
  @@map("classes")
}

// ============================================
// MATRÍCULAS NA TURMA (relação Class x Lead)
// ============================================

enum ClassStudentStatus {
  ATIVA
  TRANCADA
  CONCLUIDA
  CANCELADA
}

model ClassStudent {
  id         String             @id @default(cuid())
  classId    String
  leadId     String
  status     ClassStudentStatus @default(ATIVA)
  enrolledAt DateTime           @default(now())
  finishedAt DateTime?
  notes      String?            @db.Text

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([classId, leadId])
  @@index([classId])
  @@index([leadId])
  @@index([status])
  @@map("class_students")
}

// ============================================
// CAMPANHAS DE MARKETING
// ============================================

enum CampaignStatus {
  PLANEJADA
  ATIVA
  PAUSADA
  ENCERRADA
}

enum CampaignChannel {
  INSTAGRAM
  FACEBOOK
  GOOGLE_ADS
  WHATSAPP
  EMAIL
  INDICACAO
  OUTRO
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  channel     CampaignChannel
  startDate   DateTime
  endDate     DateTime?
  budget      Decimal?        @db.Decimal(10, 2)
  status      CampaignStatus  @default(PLANEJADA)
  description String?         @db.Text
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User   @relation("CampaignCreator", fields: [createdById], references: [id])
  leads     Lead[]

  @@map("campaigns")
}

// ============================================
// LEADS (núcleo do funil)
// ============================================

enum LeadStatus {
  NOVO
  QUALIFICADO
  PROPOSTA_ENVIADA
  EM_NEGOCIACAO
  AGUARDANDO_ANALISE
  DEVOLVIDA_AJUSTE
  APROVADA
  PERDIDA
}

model Lead {
  id           String     @id @default(cuid())
  fullName     String
  email        String?
  phone        String
  cpf          String?
  status       LeadStatus @default(NOVO)
  courseId     String?
  campaignId   String?
  assignedToId String?
  createdById  String
  notes        String?    @db.Text
  lostReason   String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course       Course?         @relation(fields: [courseId], references: [id])
  campaign     Campaign?       @relation(fields: [campaignId], references: [id])
  assignedTo   User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User            @relation("LeadCreator", fields: [createdById], references: [id])
  interactions Interaction[]
  preEnrollment PreEnrollment?
  documents    Document[]
  audits       EnrollmentAudit[]
  classStudents ClassStudent[]

  @@index([status])
  @@index([assignedToId])
  @@index([campaignId])
  @@map("leads")
}

// ============================================
// INTERAÇÕES (histórico de contato)
// ============================================

enum InteractionType {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  OUTRO
}

model Interaction {
  id          String          @id @default(cuid())
  leadId      String
  type        InteractionType
  description String          @db.Text
  occurredAt  DateTime        @default(now())
  createdById String
  createdAt   DateTime        @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([leadId])
  @@map("interactions")
}

// ============================================
// PRÉ-MATRÍCULA
// ============================================

enum PreEnrollmentStatus {
  RASCUNHO
  AGUARDANDO_ANALISE
  DEVOLVIDA
  APROVADA
}

model PreEnrollment {
  id              String              @id @default(cuid())
  leadId          String              @unique
  classId         String?
  birthDate       DateTime?
  cpf             String?
  rg              String?
  addressStreet   String?
  addressNumber   String?
  addressComplement String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  guardianName    String?
  guardianCpf     String?
  guardianPhone   String?
  status          PreEnrollmentStatus @default(RASCUNHO)
  returnReason    String?             @db.Text
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lead  Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id])

  @@map("pre_enrollments")
}

// ============================================
// DOCUMENTOS
// ============================================

enum DocumentType {
  CPF
  RG
  COMPROVANTE_RESIDENCIA
  HISTORICO_ESCOLAR
  FOTO
  OUTRO
}

model Document {
  id         String       @id @default(cuid())
  leadId     String
  type       DocumentType
  fileName   String
  filePath   String       // caminho relativo ao STORAGE_PATH
  mimeType   String
  size       Int          // bytes
  version    Int          @default(1)
  uploadedById String
  uploadedAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@map("documents")
}

// ============================================
// AUDITORIA
// ============================================

enum AuditAction {
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  PRE_ENROLLMENT_SUBMITTED
  PRE_ENROLLMENT_APPROVED
  PRE_ENROLLMENT_RETURNED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  DOCUMENT_UPLOADED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_STATUS_CHANGED
}

model EnrollmentAudit {
  id         String      @id @default(cuid())
  leadId     String?
  action     AuditAction
  actorId    String
  details    String?     @db.Text
  targetType String?
  targetId   String?
  createdAt  DateTime    @default(now())

  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([leadId])
  @@index([actorId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("enrollment_audits")
}
