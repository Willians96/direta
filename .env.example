# ============================================
# GESCOLA — Variáveis de Ambiente
# Copie para .env.local (dev) ou .env.production (prod)
# ============================================

# --- Banco de Dados (PostgreSQL) ---
# Opção A — Neon Cloud (HOJE: produção na Vercel):
#   1. Crie um projeto em https://neon.tech (free tier)
#   2. Copie a "Connection string" → cole aqui
#   3. Mantenha ?sslmode=require no final
#   Exemplo:
#     DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/gescola?sslmode=require"
#
# Opção B — Postgres local via Docker (só desenvolvimento):
#   docker compose up -d
#   DATABASE_URL="postgresql://gescola:dev@127.0.0.1:5432/gescola?schema=public"
#
# Opção C — Postgres da VPS (FUTURO: quando subirmos para a Hostinger):
#   DATABASE_URL="postgresql://gescola_app:SUA_SENHA@127.0.0.1:5432/gescola?schema=public"
DATABASE_URL="postgresql://gescola:dev@127.0.0.1:5432/gescola?schema=public"

# --- Auth.js v5 ---
# Gerar com: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_USE_OPENSSL_RAND_BASE64_32"
# Dev: http://localhost:3000 | Vercel: https://direta-ten.vercel.app | VPS: http://IP_DA_VPS
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Storage de Documentos ---
# O app usa o Vercel Blob quando encontra BLOB_READ_WRITE_TOKEN (persistência real).
# Sem essa variável, usa o filesystem local:
#   DEV:    ./storage — persistente
#   VERCEL: cai para /tmp (gravável, mas temporário: o arquivo se perde a cada deploy)
#   VPS:    STORAGE_PATH="/var/app/storage" — persistente em disco
STORAGE_PATH="./storage"

# --- Vercel Blob (produção na Vercel) ---
# Criar em: painel da Vercel → Storage → Create → Blob store → Connect
# A Vercel cria a variável BLOB_READ_WRITE_TOKEN automaticamente.
# Com ela definida, os documentos são gravados/lidos no Blob (privados).
# BLOB_READ_WRITE_TOKEN="vercel_blob_xxx"

# --- Ambiente ---
NODE_ENV="development"

# --- Opcional: monitoramento ---
# NEXT_PUBLIC_UPTIME_KUMA_URL="https://monitor.seudominio.com"
